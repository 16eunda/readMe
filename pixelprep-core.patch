+export function calculateConstrainedOutputSize(
+  width: number,
+  height: number,
+  targetLongEdge: number | null,
+  preventDownscale: boolean,
+  minShortEdge: number | null,
+  maxLongEdge: number | null,
+): OutputSize {
+  const sourceWidth = Math.max(1, Math.round(width));
+  const sourceHeight = Math.max(1, Math.round(height));
+  const sourceLong = Math.max(sourceWidth, sourceHeight);
+  const sourceShort = Math.min(sourceWidth, sourceHeight);
+  let scale = 1;
+
+  if (targetLongEdge && targetLongEdge > 0) {
+    const targetScale = targetLongEdge / sourceLong;
+    scale = preventDownscale ? Math.max(1, targetScale) : targetScale;
+  }
+  if (minShortEdge && minShortEdge > 0) {
+    scale = Math.max(scale, minShortEdge / sourceShort);
+  }
+  if (maxLongEdge && maxLongEdge > 0) {
+    scale = Math.min(scale, maxLongEdge / sourceLong);
+  }
+
+  return {
+    width: Math.max(1, Math.round(sourceWidth * scale)),
+    height: Math.max(1, Math.round(sourceHeight * scale)),
+  };
+}
