{
  "expo": {
    "name": "MyReaderApp2",
    "slug": "MyReaderApp2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myreaderapp2",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "EPUB Document",
            "CFBundleTypeIconFiles": [],
            "LSItemContentTypes": [
              "org.idpf.epub-container"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "Plain Text",
            "CFBundleTypeIconFiles": [],
            "LSItemContentTypes": [
              "public.plain-text"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "EPUB Document",
            "CFBundleTypeIconFiles": [],
            "LSItemContentTypes": [
              "org.idpf.epub-container"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          },
          {
            "CFBundleTypeName": "Plain Text",
            "CFBundleTypeIconFiles": [],
            "LSItemContentTypes": [
              "public.plain-text"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "org.idpf.epub-container",
            "UTTypeDescription": "EPUB Document",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "epub"
              ],
              "public.mime-type": "application/epub+zip"
            }
          },
          {
            "UTTypeIdentifier": "org.idpf.epub-container",
            "UTTypeDescription": "EPUB Document",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "epub"
              ],
              "public.mime-type": "application/epub+zip"
            }
          }
        ]
      },
      "bundleIdentifier": "com.readme.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7E8",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "mimeType": "application/epub+zip"
            }
          ]
        }
      ],
      "package": "com.readme.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7E8",
          "dark": {
            "backgroundColor": "#FFF7E8"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0aaae35-0251-4c16-9639-29bf6bcfc2ff"
      }
    },
    "owner": "16jung"
  }
}
